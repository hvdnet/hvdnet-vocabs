@prefix dct: <http://purl.org/dc/terms/> .
@prefix qsv: <https://w3id.org/hvdnet/qsv/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix stats: <https://w3id.org/hvdnet/statistics/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

qsv: a skos:ConceptScheme ;
    dct:title "QSV Vocabulary [DRAFT]"@en ;
    rdfs:label "QSV Vocabulary [DRAFT]"@en ;
    dct:description "This vocabulary provides a controlled set of concepts for describing statistical measures and summary statistics generated by the QSV Data Wrangling package."@en ;
    dct:source <https://qsv.dathere.com/> ;
    dct:created "2025-12-22"^^xsd:date ;
    dct:modified "2026-11-15"^^xsd:date ;
    skos:hasTopConcept qsv:statsCmd, qsv:moarstatsCmd ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> .
qsv:statsCmd a skos:Concept ;
    skos:prefLabel "stats command"@en ;
    skos:topConceptOf qsv: ;
    skos:inScheme qsv: ;
    skos:definition "Statistical measures and summary statistics generated by the 'stats' command in the QSV Data Wrangling package."@en ;
    rdfs:seeAlso <https://github.com/dathere/qsv/blob/main/src/cmd/stats.rs> ;
    skos:narrower
        qsv:antimode, qsv:antimode_count, qsv:antimode_occurrences, qsv:avg_length, qsv:cardinality, qsv:cv, 
        qsv:cv_length, qsv:geometric_mean, qsv:harmonic_mean, qsv:iqr, qsv:is_ascii, qsv:lower_inner_fence, 
        qsv:lower_outer_fence, qsv:mad, qsv:max, qsv:max_length, qsv:max_precision, qsv:mean, qsv:min, qsv:min_length, 
        qsv:mode, qsv:mode_count, qsv:mode_occurrences, qsv:n_negative, qsv:n_positive, qsv:n_zero, qsv:nullcount, 
        qsv:percentiles, qsv:q1, qsv:q2_median, qsv:q3, qsv:range, qsv:sem, qsv:skewness, qsv:sort_order, 
        qsv:sortiness, qsv:sparsity, qsv:stddev, qsv:stddev_length, qsv:sum, qsv:sum_length, qsv:type, 
        qsv:uniqueness_ratio, qsv:upper_inner_fence, qsv:upper_outer_fence, qsv:variance, qsv:variance_length, 
        qsv:zero_padded_numeric .

qsv:moarstatsCmd a skos:Concept ;
    skos:prefLabel "moarstats command"@en ;
    skos:topConceptOf qsv: ;
    skos:inScheme qsv: ;
    skos:definition "Additional statistical measures and summary statistics generated by the 'moarstats' command in the QSV Data Wrangling package."@en ;
    rdfs:seeAlso <https://github.com/dathere/qsv/blob/main/src/cmd/moarstats.rs> ;
    skos:narrower
        qsv:atkinson_index, qsv:benford_mad, qsv:berger_parker_dominance, qsv:bimodality_coefficient, 
        qsv:covariance_population, qsv:covariance_sample, qsv:cramers_v, qsv:gini_coefficient, qsv:hoover_index, 
        qsv:iqr_normalized, qsv:iqr_range_ratio, qsv:jarque_bera, qsv:jarque_bera_pvalue, qsv:kelly_skewness, 
        qsv:kendall_tau, qsv:kurtosis, qsv:l_cv, qsv:l_kurtosis, qsv:l_skewness, qsv:lag1_autocorrelation, 
        qsv:lower_outer_fence_zscore, qsv:mad_normalized, qsv:mad_stddev_ratio, qsv:max_zscore, qsv:mean_ad, 
        qsv:median_mean_ratio, qsv:midhinge, qsv:min_zscore, qsv:mode_zscore, qsv:moment_skewness, 
        qsv:mutual_information, qsv:n_pairs, qsv:non_outliers_cv, qsv:non_outliers_mean, qsv:non_outliers_stddev, 
        qsv:non_outliers_variance, qsv:normalized_entropy, qsv:normalized_mutual_information, qsv:outlier_impact, 
        qsv:outlier_impact_ratio, qsv:outliers_cv, qsv:outliers_extreme_lower_cnt, qsv:outliers_extreme_upper_cnt, 
        qsv:outliers_max, qsv:outliers_mean, qsv:outliers_mild_lower_cnt, qsv:outliers_mild_upper_cnt, 
        qsv:outliers_min, qsv:outliers_normal_cnt, qsv:outliers_normal_stddev_ratio, qsv:outliers_percentage, 
        qsv:outliers_range, qsv:outliers_stddev, qsv:outliers_to_normal_mean_ratio, qsv:outliers_total_cnt, 
        qsv:outliers_variance, qsv:pearson_correlation, qsv:pearson_skewness, qsv:percentile_ratio_90_10, 
        qsv:quartile_coefficient_dispersion, qsv:r_squared, qsv:range_stddev_ratio, qsv:regression_intercept, 
        qsv:regression_slope, qsv:relative_standard_error, qsv:robust_cv, qsv:robust_max_zscore, qsv:robust_min_zscore, 
        qsv:shannon_entropy, qsv:simpsons_diversity_index, qsv:spearman_correlation, qsv:theil_index, qsv:trimean, 
        qsv:trimmed_25pct_stddev_ratio, qsv:trimmed_cv_25pct, qsv:trimmed_mean_25pct, qsv:trimmed_range_25pct, 
        qsv:trimmed_stddev_25pct, qsv:trimmed_variance_25pct, qsv:u_field1_given_field2, qsv:u_field2_given_field1, 
        qsv:upper_outer_fence_zscore, qsv:winsorized_25pct_stddev_ratio, qsv:winsorized_cv_25pct, 
        qsv:winsorized_mean_25pct, qsv:winsorized_range_25pct, qsv:winsorized_stddev_25pct, 
        qsv:winsorized_variance_25pct, qsv:xsd_type, qsv:zero_share .

# Unmapped (QSV-specific or granular breakdown concepts without direct stats: match):
# stats: qsv:sortiness, qsv:mode_count, qsv:mode_occurrences, qsv:antimode, qsv:antimode_count, qsv:antimode_occurrences.
# moarstats: qsv:min_zscore, qsv:max_zscore, qsv:median_mean_ratio, qsv:iqr_range_ratio, qsv:mad_stddev_ratio,
# qsv:robust_min_zscore, qsv:robust_max_zscore, qsv:jarque_bera_pvalue, qsv:n_pairs,
# qsv:outliers_extreme_lower_cnt, qsv:outliers_mild_lower_cnt, qsv:outliers_normal_cnt, qsv:outliers_mild_upper_cnt,
# qsv:outliers_extreme_upper_cnt, qsv:outliers_mean, qsv:non_outliers_mean, qsv:outliers_to_normal_mean_ratio,
# qsv:outliers_min, qsv:outliers_max, qsv:outliers_range, qsv:outliers_stddev, qsv:outliers_variance, qsv:non_outliers_stddev,
# qsv:non_outliers_variance, qsv:outliers_cv, qsv:non_outliers_cv, qsv:outlier_impact, qsv:outlier_impact_ratio,
# qsv:outliers_normal_stddev_ratio, qsv:lower_outer_fence_zscore, qsv:upper_outer_fence_zscore.
# Minimal concept stubs (can be enriched later)

qsv:type a skos:Concept ;
    skos:prefLabel "type"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:statsCmd ;
    skos:exactMatch stats:InferredDataType ;
    skos:definition "The inferred QSV field type for a column (e.g., string, integer, float, date)."@en .

qsv:is_ascii a skos:Concept ;
    skos:prefLabel "is_ascii"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:statsCmd ;
    skos:exactMatch stats:IsAscii ;
    skos:definition "Whether all non-null values contain only ASCII characters."@en .

qsv:sum a skos:Concept ;
    skos:prefLabel "sum"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:statsCmd ;
    skos:exactMatch stats:Sum ;
    skos:definition "The sum of all numeric values."@en .

qsv:min a skos:Concept ;
    skos:prefLabel "min"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:statsCmd ;
    skos:exactMatch stats:Minimum ;
    skos:definition "The minimum observed value."@en .

qsv:max a skos:Concept ;
    skos:prefLabel "max"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:statsCmd ;
    skos:exactMatch stats:Maximum ;
    skos:definition "The maximum observed value."@en .

qsv:range a skos:Concept ;
    skos:prefLabel "range"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:statsCmd ;
    skos:exactMatch stats:Range ;
    skos:definition "The difference between the maximum and minimum values (max − min)."@en .

qsv:sort_order a skos:Concept ;
    skos:prefLabel "sort_order"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:statsCmd ;
    skos:exactMatch stats:SortOrder ;
    skos:definition "A categorical indicator of whether values appear sorted (e.g., ascending, descending, or unsorted)."@en .

qsv:sortiness a skos:Concept ;
    skos:prefLabel "sortiness"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:statsCmd ;
    skos:definition "A numeric score indicating how close the column is to being sorted (higher means more sorted)."@en .

qsv:min_length a skos:Concept ;
    skos:prefLabel "min_length"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:statsCmd ;
    skos:exactMatch stats:MinLength ;
    skos:definition "The minimum string length among non-null values."@en .

qsv:max_length a skos:Concept ;
    skos:prefLabel "max_length"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:statsCmd ;
    skos:exactMatch stats:MaxLength ;
    skos:definition "The maximum string length among non-null values."@en .

qsv:sum_length a skos:Concept ;
    skos:prefLabel "sum_length"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:statsCmd ;
    skos:exactMatch stats:TotalCharacterLength ;
    skos:definition "The total string length across all non-null values (sum of character counts)."@en .

qsv:avg_length a skos:Concept ;
    skos:prefLabel "avg_length"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:statsCmd ;
    skos:exactMatch stats:AverageLength ;
    skos:definition "The average string length of non-null values."@en .

qsv:stddev_length a skos:Concept ;
    skos:prefLabel "stddev_length"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:statsCmd ;
    skos:exactMatch stats:LengthStdDev ;
    skos:definition "The standard deviation of string lengths across non-null values."@en .

qsv:variance_length a skos:Concept ;
    skos:prefLabel "variance_length"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:statsCmd ;
    skos:exactMatch stats:LengthVariance ;
    skos:definition "The variance of string lengths across non-null values."@en .

qsv:cv_length a skos:Concept ;
    skos:prefLabel "cv_length"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:statsCmd ;
    skos:exactMatch stats:LengthCoefficientOfVariation ;
    skos:definition "The coefficient of variation of string lengths (stddev_length divided by avg_length)."@en .

qsv:mean a skos:Concept ;
    skos:prefLabel "mean"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:statsCmd ;
    skos:exactMatch stats:ArithmeticMean ;
    skos:definition "The arithmetic mean (average) of numeric values."@en .

qsv:sem a skos:Concept ;
    skos:prefLabel "sem"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:statsCmd ;
    skos:exactMatch stats:StandardErrorOfMean ;
    skos:definition "The standard error of the mean (estimated standard deviation of the sample mean)."@en .

qsv:geometric_mean a skos:Concept ;
    skos:prefLabel "geometric_mean"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:statsCmd ;
    skos:exactMatch stats:GeometricMean ;
    skos:definition "The geometric mean of numeric values."@en .

qsv:harmonic_mean a skos:Concept ;
    skos:prefLabel "harmonic_mean"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:statsCmd ;
    skos:exactMatch stats:HarmonicMean ;
    skos:definition "The harmonic mean of numeric values."@en .

qsv:stddev a skos:Concept ;
    skos:prefLabel "stddev"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:statsCmd ;
    skos:exactMatch stats:StandardDeviation ;
    skos:definition "The standard deviation of numeric values."@en .

qsv:variance a skos:Concept ;
    skos:prefLabel "variance"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:statsCmd ;
    skos:exactMatch stats:Variance ;
    skos:definition "The variance of numeric values."@en .

qsv:cv a skos:Concept ;
    skos:prefLabel "cv"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:statsCmd ;
    skos:exactMatch stats:CoefficientOfVariation ;
    skos:definition "The coefficient of variation of numeric values (stddev divided by mean)."@en .

qsv:nullcount a skos:Concept ;
    skos:prefLabel "nullcount"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:statsCmd ;
    skos:exactMatch stats:NullCases ;
    skos:definition "The number of null or missing values."@en .

qsv:n_negative a skos:Concept ;
    skos:prefLabel "n_negative"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:statsCmd ;
    skos:exactMatch stats:NegativeCount ;
    skos:definition "The number of numeric values that are negative."@en .

qsv:n_zero a skos:Concept ;
    skos:prefLabel "n_zero"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:statsCmd ;
    skos:exactMatch stats:ZeroCount ;
    skos:definition "The number of numeric values that are exactly zero."@en .

qsv:n_positive a skos:Concept ;
    skos:prefLabel "n_positive"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:statsCmd ;
    skos:exactMatch stats:PositiveCount ;
    skos:definition "The number of numeric values that are positive."@en .

qsv:max_precision a skos:Concept ;
    skos:prefLabel "max_precision"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:statsCmd ;
    skos:exactMatch stats:DecimalPrecision ;
    skos:definition "The maximum number of decimal places observed for numeric values."@en .

qsv:sparsity a skos:Concept ;
    skos:prefLabel "sparsity"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:statsCmd ;
    skos:exactMatch stats:Sparsity ;
    skos:definition "A measure of missingness, indicating how sparse the column is due to null or empty values."@en .

qsv:mad a skos:Concept ;
    skos:prefLabel "mad"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:statsCmd ;
    skos:exactMatch stats:MedianAbsoluteDeviation ;
    skos:definition "The median absolute deviation (median of |x − median(x)|)."@en .

qsv:lower_outer_fence a skos:Concept ;
    skos:prefLabel "lower_outer_fence"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:statsCmd ;
    skos:exactMatch stats:LowerOuterFence ;
    skos:definition "The lower outer Tukey fence for outliers (typically Q1 − 3×IQR)."@en .

qsv:lower_inner_fence a skos:Concept ;
    skos:prefLabel "lower_inner_fence"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:statsCmd ;
    skos:exactMatch stats:LowerInnerFence ;
    skos:definition "The lower inner Tukey fence for outliers (typically Q1 − 1.5×IQR)."@en .
qsv:q1 a skos:Concept ;
    skos:prefLabel "q1"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:statsCmd ;
    skos:exactMatch stats:FirstQuartile ;
    skos:definition "The first quartile (25th percentile)."@en .

qsv:q2_median a skos:Concept ;
    skos:prefLabel "q2_median"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:statsCmd ;
    skos:exactMatch stats:Median ;
    skos:definition "The median (50th percentile)."@en .

qsv:q3 a skos:Concept ;
    skos:prefLabel "q3"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:statsCmd ;
    skos:exactMatch stats:ThirdQuartile ;
    skos:definition "The third quartile (75th percentile)."@en .

qsv:iqr a skos:Concept ;
    skos:prefLabel "iqr"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:statsCmd ;
    skos:exactMatch stats:InterquartileRange ;
    skos:definition "The interquartile range (Q3 − Q1)."@en .
qsv:upper_inner_fence a skos:Concept ;
    skos:prefLabel "upper_inner_fence"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:statsCmd ;
    skos:exactMatch stats:UpperInnerFence ;
    skos:definition "The upper inner Tukey fence for outliers (typically Q3 + 1.5×IQR)."@en .

qsv:upper_outer_fence a skos:Concept ;
    skos:prefLabel "upper_outer_fence"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:statsCmd ;
    skos:exactMatch stats:UpperOuterFence ;
    skos:definition "The upper outer Tukey fence for outliers (typically Q3 + 3×IQR)."@en .

qsv:skewness a skos:Concept ;
    skos:prefLabel "skewness"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:statsCmd ;
    skos:exactMatch stats:BowleySkewnessCoefficient ;
    skos:definition "A measure of asymmetry of the numeric value distribution (quartile-based Bowley skewness)."@en .
qsv:cardinality a skos:Concept ;
    skos:prefLabel "cardinality"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:statsCmd ;
    skos:exactMatch stats:UniqueCases ;
    skos:definition "The number of distinct (unique) non-null values."@en .

qsv:uniqueness_ratio a skos:Concept ;
    skos:prefLabel "uniqueness_ratio"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:statsCmd ;
    skos:exactMatch stats:DistinctnessRatio ;
    skos:definition "The fraction of distinct values among non-null values (cardinality divided by valid count)."@en .

qsv:mode a skos:Concept ;
    skos:prefLabel "mode"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:statsCmd ;
    skos:exactMatch stats:Mode ;
    skos:definition "The most frequently occurring non-null value."@en .

qsv:mode_count a skos:Concept ;
    skos:prefLabel "mode_count"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:statsCmd ;
    skos:definition "The frequency (count) of the mode value."@en .

qsv:mode_occurrences a skos:Concept ;
    skos:prefLabel "mode_occurrences"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:statsCmd ;
    skos:definition "The number of distinct values tied for the highest frequency (the number of modes)."@en .

qsv:antimode a skos:Concept ;
    skos:prefLabel "antimode"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:statsCmd ;
    skos:definition "A least-frequent value among those that occur at least once (the rarest observed value)."@en .

qsv:antimode_count a skos:Concept ;
    skos:prefLabel "antimode_count"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:statsCmd ;
    skos:definition "The minimum non-zero frequency among observed values (count of the antimode)."@en .

qsv:antimode_occurrences a skos:Concept ;
    skos:prefLabel "antimode_occurrences"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:statsCmd ;
    skos:definition "The number of distinct values tied for the minimum non-zero frequency (the number of antimodes)."@en .

qsv:percentiles a skos:Concept ;
    skos:prefLabel "percentiles"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:statsCmd ;
    skos:exactMatch stats:OtherPercentile ;
    skos:definition "One or more percentile values (e.g., p10, p25, p50) computed for numeric columns."@en .


qsv:zero_padded_numeric a skos:Concept ;
    skos:prefLabel "zero_padded_numeric"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:statsCmd ;
    skos:exactMatch stats:ZeroPaddedNumeric ;
    skos:definition "Indicates whether leading or padding zeros would be lost if values were cast to a number (true for text columns where all non-null values are numeric and at least one has leading zeros)."@en .

# moarstats concept stubs

qsv:pearson_skewness a skos:Concept ;
    skos:prefLabel "pearson_skewness"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:moarstatsCmd ;
    skos:exactMatch stats:PearsonSkewness ;
    skos:definition "Pearson’s skewness coefficient (a skewness estimate based on mean, median, and standard deviation)."@en .

qsv:range_stddev_ratio a skos:Concept ;
    skos:prefLabel "range_stddev_ratio"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:moarstatsCmd ;
    skos:exactMatch stats:StdDevRangeRatio ;
    skos:definition "The ratio of the range to the standard deviation (range divided by stddev)."@en .

qsv:quartile_coefficient_dispersion a skos:Concept ;
    skos:prefLabel "quartile_coefficient_dispersion"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:moarstatsCmd ;
    skos:exactMatch stats:QuartileDispersionCoefficient ;
    skos:definition "The quartile dispersion coefficient, typically (Q3 − Q1) / (Q3 + Q1)."@en .

qsv:mode_zscore a skos:Concept ;
    skos:prefLabel "mode_zscore"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:moarstatsCmd ;
    skos:exactMatch stats:ModeZScore ;
    skos:definition "The z-score of the mode value (mode minus mean, divided by stddev)."@en .

qsv:relative_standard_error a skos:Concept ;
    skos:prefLabel "relative_standard_error"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:moarstatsCmd ;
    skos:exactMatch stats:RelativeStandardError ;
    skos:definition "The standard error of the mean divided by the mean (SEM/mean)."@en .

qsv:min_zscore a skos:Concept ;
    skos:prefLabel "min_zscore"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:moarstatsCmd ;
    skos:definition "The z-score of the minimum value: (min − mean) / stddev."@en .

qsv:max_zscore a skos:Concept ;
    skos:prefLabel "max_zscore"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:moarstatsCmd ;
    skos:definition "The z-score of the maximum value: (max − mean) / stddev."@en .

qsv:median_mean_ratio a skos:Concept ;
    skos:prefLabel "median_mean_ratio"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:moarstatsCmd ;
    skos:definition "The ratio of the median to the mean (median/mean)."@en .

qsv:iqr_range_ratio a skos:Concept ;
    skos:prefLabel "iqr_range_ratio"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:moarstatsCmd ;
    skos:definition "The ratio of interquartile range to range (IQR/range)."@en .

qsv:mad_stddev_ratio a skos:Concept ;
    skos:prefLabel "mad_stddev_ratio"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:moarstatsCmd ;
    skos:definition "The ratio of median absolute deviation to standard deviation (MAD/stddev)."@en .

qsv:kurtosis a skos:Concept ;
    skos:prefLabel "kurtosis"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:moarstatsCmd ;
    skos:exactMatch stats:SampleExcessKurtosis ;
    skos:definition "A measure of tail-heaviness/peakedness of the distribution (sample excess kurtosis, G2)."@en .

qsv:gini_coefficient a skos:Concept ;
    skos:prefLabel "gini_coefficient"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:moarstatsCmd ;
    skos:exactMatch stats:GiniCoefficient ;
    skos:definition "The Gini coefficient measuring inequality/dispersion of numeric values (0 = equal, 1 = maximal inequality)."@en .
qsv:outliers_extreme_lower_cnt a skos:Concept ;
    skos:prefLabel "outliers_extreme_lower_cnt"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:moarstatsCmd ;
    skos:definition "Count of extreme lower outliers (values below the lower outer fence, typically Q1 − 3×IQR)."@en .

qsv:outliers_mild_lower_cnt a skos:Concept ;
    skos:prefLabel "outliers_mild_lower_cnt"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:moarstatsCmd ;
    skos:definition "Count of mild lower outliers (between lower outer and lower inner fences)."@en .

qsv:outliers_normal_cnt a skos:Concept ;
    skos:prefLabel "outliers_normal_cnt"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:moarstatsCmd ;
    skos:definition "Count of values within the inner fences (non-outliers by the IQR rule)."@en .

qsv:outliers_mild_upper_cnt a skos:Concept ;
    skos:prefLabel "outliers_mild_upper_cnt"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:moarstatsCmd ;
    skos:definition "Count of mild upper outliers (between upper inner and upper outer fences)."@en .

qsv:outliers_extreme_upper_cnt a skos:Concept ;
    skos:prefLabel "outliers_extreme_upper_cnt"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:moarstatsCmd ;
    skos:definition "Count of extreme upper outliers (values above the upper outer fence, typically Q3 + 3×IQR)."@en .

qsv:outliers_total_cnt a skos:Concept ;
    skos:prefLabel "outliers_total_cnt"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:moarstatsCmd ;
    skos:exactMatch stats:OutlierCountIQR ;
    skos:definition "Total count of outliers outside the inner fences (mild + extreme)."@en .

qsv:outliers_mean a skos:Concept ;
    skos:prefLabel "outliers_mean"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:moarstatsCmd ;
    skos:definition "The mean of values classified as outliers."@en .

qsv:non_outliers_mean a skos:Concept ;
    skos:prefLabel "non_outliers_mean"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:moarstatsCmd ;
    skos:definition "The mean of values classified as non-outliers (within inner fences)."@en .

qsv:outliers_to_normal_mean_ratio a skos:Concept ;
    skos:prefLabel "outliers_to_normal_mean_ratio"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:moarstatsCmd ;
    skos:definition "The ratio of outlier mean to non-outlier mean (outliers_mean/non_outliers_mean)."@en .
qsv:outliers_min a skos:Concept ;
    skos:prefLabel "outliers_min"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:moarstatsCmd ;
    skos:definition "The minimum value among outliers."@en .

qsv:outliers_max a skos:Concept ;
    skos:prefLabel "outliers_max"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:moarstatsCmd ;
    skos:definition "The maximum value among outliers."@en .

qsv:outliers_range a skos:Concept ;
    skos:prefLabel "outliers_range"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:moarstatsCmd ;
    skos:definition "The range among outliers (outliers_max − outliers_min)."@en .

qsv:outliers_stddev a skos:Concept ;
    skos:prefLabel "outliers_stddev"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:moarstatsCmd ;
    skos:definition "The standard deviation of outlier values."@en .

qsv:outliers_variance a skos:Concept ;
    skos:prefLabel "outliers_variance"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:moarstatsCmd ;
    skos:definition "The variance of outlier values."@en .

qsv:non_outliers_stddev a skos:Concept ;
    skos:prefLabel "non_outliers_stddev"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:moarstatsCmd ;
    skos:definition "The standard deviation of non-outlier values (within inner fences)."@en .

qsv:non_outliers_variance a skos:Concept ;
    skos:prefLabel "non_outliers_variance"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:moarstatsCmd ;
    skos:definition "The variance of non-outlier values (within inner fences)."@en .

qsv:outliers_cv a skos:Concept ;
    skos:prefLabel "outliers_cv"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:moarstatsCmd ;
    skos:definition "The coefficient of variation for outlier values (outliers_stddev/outliers_mean)."@en .

qsv:non_outliers_cv a skos:Concept ;
    skos:prefLabel "non_outliers_cv"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:moarstatsCmd ;
    skos:definition "The coefficient of variation for non-outlier values (non_outliers_stddev/non_outliers_mean)."@en .

qsv:outliers_percentage a skos:Concept ;
    skos:prefLabel "outliers_percentage"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:moarstatsCmd ;
    skos:exactMatch stats:OutlierPercentage ;
    skos:definition "The percentage of values classified as outliers (outliers_total_cnt / valid_count × 100)."@en .

qsv:outlier_impact a skos:Concept ;
    skos:prefLabel "outlier_impact"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:moarstatsCmd ;
    skos:definition "A measure of how much outliers shift the mean (difference between overall mean and non-outlier mean)."@en .

qsv:outlier_impact_ratio a skos:Concept ;
    skos:prefLabel "outlier_impact_ratio"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:moarstatsCmd ;
    skos:definition "A normalized outlier impact measure expressed as a ratio (outlier_impact relative to a baseline mean)."@en .

qsv:outliers_normal_stddev_ratio a skos:Concept ;
    skos:prefLabel "outliers_normal_stddev_ratio"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:moarstatsCmd ;
    skos:definition "The ratio of outlier standard deviation to non-outlier standard deviation (outliers_stddev/non_outliers_stddev)."@en .

qsv:lower_outer_fence_zscore a skos:Concept ;
    skos:prefLabel "lower_outer_fence_zscore"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:moarstatsCmd ;
    skos:definition "The z-score of the lower outer fence threshold: (lower_outer_fence − mean) / stddev."@en .

qsv:upper_outer_fence_zscore a skos:Concept ;
    skos:prefLabel "upper_outer_fence_zscore"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:moarstatsCmd ;
    skos:definition "The z-score of the upper outer fence threshold: (upper_outer_fence − mean) / stddev."@en .
qsv:winsorized_mean_25pct a skos:Concept ;
    skos:prefLabel "winsorized_mean_25pct"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:moarstatsCmd ;
    skos:exactMatch stats:WinsorizedMean ;
    skos:definition "The mean after winsorizing 25% tails (clamping extreme values to the 25th/75th percentile boundaries)."@en .

qsv:trimmed_mean_25pct a skos:Concept ;
    skos:prefLabel "trimmed_mean_25pct"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:moarstatsCmd ;
    skos:exactMatch stats:TrimmedMean ;
    skos:definition "The mean after trimming 25% lowest and 25% highest values (middle 50% of the sample)."@en .

qsv:trimmed_stddev_25pct a skos:Concept ;
    skos:prefLabel "trimmed_stddev_25pct"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:moarstatsCmd ;
    skos:broadMatch stats:TrimmedMean ;
    skos:definition "The standard deviation computed on the 25% trimmed sample."@en .

qsv:trimmed_variance_25pct a skos:Concept ;
    skos:prefLabel "trimmed_variance_25pct"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:moarstatsCmd ;
    skos:broadMatch stats:TrimmedMean ;
    skos:definition "The variance computed on the 25% trimmed sample."@en .

qsv:winsorized_stddev_25pct a skos:Concept ;
    skos:prefLabel "winsorized_stddev_25pct"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:moarstatsCmd ;
    skos:broadMatch stats:WinsorizedMean ;
    skos:definition "The standard deviation computed on the 25% winsorized sample."@en .

qsv:winsorized_variance_25pct a skos:Concept ;
    skos:prefLabel "winsorized_variance_25pct"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:moarstatsCmd ;
    skos:broadMatch stats:WinsorizedMean ;
    skos:definition "The variance computed on the 25% winsorized sample."@en .

qsv:trimmed_cv_25pct a skos:Concept ;
    skos:prefLabel "trimmed_cv_25pct"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:moarstatsCmd ;
    skos:broadMatch stats:TrimmedMean ;
    skos:definition "The coefficient of variation computed on the 25% trimmed sample (trimmed_stddev_25pct/trimmed_mean_25pct)."@en .

qsv:winsorized_cv_25pct a skos:Concept ;
    skos:prefLabel "winsorized_cv_25pct"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:moarstatsCmd ;
    skos:broadMatch stats:WinsorizedMean ;
    skos:definition "The coefficient of variation computed on the 25% winsorized sample (winsorized_stddev_25pct/winsorized_mean_25pct)."@en .

qsv:trimmed_25pct_stddev_ratio a skos:Concept ;
    skos:prefLabel "trimmed_25pct_stddev_ratio"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:moarstatsCmd ;
    skos:broadMatch stats:TrimmedMean ;
    skos:definition "The ratio of trimmed to untrimmed standard deviation (trimmed_stddev_25pct/stddev)."@en .

qsv:winsorized_25pct_stddev_ratio a skos:Concept ;
    skos:prefLabel "winsorized_25pct_stddev_ratio"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:moarstatsCmd ;
    skos:broadMatch stats:WinsorizedMean ;
    skos:definition "The ratio of winsorized to untrimmed standard deviation (winsorized_stddev_25pct/stddev)."@en .

qsv:trimmed_range_25pct a skos:Concept ;
    skos:prefLabel "trimmed_range_25pct"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:moarstatsCmd ;
    skos:broadMatch stats:TrimmedMean ;
    skos:definition "The range computed on the 25% trimmed sample."@en .

qsv:winsorized_range_25pct a skos:Concept ;
    skos:prefLabel "winsorized_range_25pct"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:moarstatsCmd ;
    skos:broadMatch stats:WinsorizedMean ;
    skos:definition "The range computed on the 25% winsorized sample."@en .

qsv:trimean a skos:Concept ;
    skos:prefLabel "trimean"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:moarstatsCmd ;
    skos:exactMatch stats:Trimean ;
    skos:definition "Tukey’s trimean, a robust measure of central tendency combining the median and quartiles: (Q1 + 2×median + Q3) / 4."@en .

qsv:midhinge a skos:Concept ;
    skos:prefLabel "midhinge"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:moarstatsCmd ;
    skos:exactMatch stats:Midhinge ;
    skos:definition "The midhinge, the arithmetic mean of the first and third quartiles: (Q1 + Q3) / 2."@en .

qsv:robust_cv a skos:Concept ;
    skos:prefLabel "robust_cv"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:moarstatsCmd ;
    skos:exactMatch stats:RobustCoefficientOfVariation ;
    skos:definition "Robust coefficient of variation calculated as median absolute deviation divided by the absolute value of the median (MAD / |median|)."@en .

qsv:mad_normalized a skos:Concept ;
    skos:prefLabel "mad_normalized"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:moarstatsCmd ;
    skos:exactMatch stats:NormalizedMAD ;
    skos:definition "Normalized median absolute deviation (MAD / 0.6745 ≈ 1.4826 × MAD), providing a robust estimator of standard deviation consistent with normal distributions."@en .

qsv:iqr_normalized a skos:Concept ;
    skos:prefLabel "iqr_normalized"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:moarstatsCmd ;
    skos:exactMatch stats:NormalizedIQR ;
    skos:definition "Normalized interquartile range (IQR / 1.349), providing a robust estimator of standard deviation consistent with normal distributions."@en .

qsv:robust_min_zscore a skos:Concept ;
    skos:prefLabel "robust_min_zscore"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:moarstatsCmd ;
    skos:definition "Iglewicz-Hoaglin modified z-score for the minimum value: 0.6745 × (min − median) / MAD."@en .

qsv:robust_max_zscore a skos:Concept ;
    skos:prefLabel "robust_max_zscore"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:moarstatsCmd ;
    skos:definition "Iglewicz-Hoaglin modified z-score for the maximum value: 0.6745 × (max − median) / MAD."@en .

qsv:kelly_skewness a skos:Concept ;
    skos:prefLabel "kelly_skewness"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:moarstatsCmd ;
    skos:exactMatch stats:KellySkewness ;
    skos:definition "Kelly’s skewness measure based on percentiles: (P90 + P10 − 2×median) / (P90 − P10)."@en .

qsv:percentile_ratio_90_10 a skos:Concept ;
    skos:prefLabel "percentile_ratio_90_10"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:moarstatsCmd ;
    skos:exactMatch stats:PercentileRatio ;
    skos:definition "The ratio of the 90th percentile to the 10th percentile (P90 / P10), measuring inequality and dispersion."@en .

qsv:zero_share a skos:Concept ;
    skos:prefLabel "zero_share"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:moarstatsCmd ;
    skos:exactMatch stats:ZeroShare ;
    skos:definition "The proportion of non-null numeric values that are exactly zero: n_zero / (n_zero + n_positive + n_negative)."@en .

qsv:berger_parker_dominance a skos:Concept ;
    skos:prefLabel "berger_parker_dominance"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:moarstatsCmd ;
    skos:exactMatch stats:BergerParkerIndex ;
    skos:definition "The Berger-Parker dominance index, representing the share of total rows accounted for by the most frequent value (mode_occurrences / row count)."@en .

qsv:moment_skewness a skos:Concept ;
    skos:prefLabel "moment_skewness"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:moarstatsCmd ;
    skos:exactMatch stats:SampleSkewness ;
    skos:definition "The adjusted Fisher-Pearson standardized moment coefficient of skewness (G1)."@en .

qsv:bimodality_coefficient a skos:Concept ;
    skos:prefLabel "bimodality_coefficient"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:moarstatsCmd ;
    skos:exactMatch stats:BimodalityCoefficient ;
    skos:definition "The bimodality coefficient (BC) based on moment skewness and kurtosis, assessing whether a distribution is bimodal or multimodal (BC > 0.555 suggests bimodality)."@en .

qsv:jarque_bera a skos:Concept ;
    skos:prefLabel "jarque_bera"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:moarstatsCmd ;
    skos:exactMatch stats:JarqueBera ;
    skos:definition "The Jarque-Bera goodness-of-fit test statistic for normality based on sample skewness and excess kurtosis."@en .

qsv:jarque_bera_pvalue a skos:Concept ;
    skos:prefLabel "jarque_bera_pvalue"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:moarstatsCmd ;
    skos:definition "The p-value corresponding to the Jarque-Bera test statistic under a chi-squared distribution with 2 degrees of freedom."@en .

qsv:atkinson_index a skos:Concept ;
    skos:prefLabel "atkinson_index"@en ;
    skos:altLabel "atkinson_index_(1)"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:moarstatsCmd ;
    skos:exactMatch stats:AtkinsonIndex ;
    skos:definition "The Atkinson index measuring income or value distribution inequality with configurable inequality aversion parameter epsilon."@en .

qsv:theil_index a skos:Concept ;
    skos:prefLabel "theil_index"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:moarstatsCmd ;
    skos:exactMatch stats:TheilIndex ;
    skos:definition "The Theil entropy index measuring inequality and concentration across positive numeric values: (1/n) × Σ((x_i / mean) × ln(x_i / mean))."@en .

qsv:mean_ad a skos:Concept ;
    skos:prefLabel "mean_ad"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:moarstatsCmd ;
    skos:exactMatch stats:AverageAbsoluteDeviation ;
    skos:definition "The mean absolute deviation from the mean: (1/n) × Σ|x_i − mean|."@en .

qsv:hoover_index a skos:Concept ;
    skos:prefLabel "hoover_index"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:moarstatsCmd ;
    skos:exactMatch stats:HooverIndex ;
    skos:definition "The Hoover index (Robin Hood index) measuring the share of the total that would need to be redistributed to achieve perfect equality: Σ|x_i − mean| / (2 × Σx_i)."@en .

qsv:l_cv a skos:Concept ;
    skos:prefLabel "l_cv"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:moarstatsCmd ;
    skos:exactMatch stats:LCV ;
    skos:definition "The coefficient of L-variation (L-CV = λ2 / λ1), a robust bounded analogue of the coefficient of variation based on linear combinations of order statistics."@en .

qsv:l_skewness a skos:Concept ;
    skos:prefLabel "l_skewness"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:moarstatsCmd ;
    skos:exactMatch stats:LSkewness ;
    skos:definition "The L-skewness ratio (τ3 = λ3 / λ2), measuring asymmetry based on linear combinations of order statistics, bounded in [-1, 1]."@en .

qsv:l_kurtosis a skos:Concept ;
    skos:prefLabel "l_kurtosis"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:moarstatsCmd ;
    skos:exactMatch stats:LKurtosis ;
    skos:definition "The L-kurtosis ratio (τ4 = λ4 / λ2), measuring peakedness/tailedness based on linear combinations of order statistics."@en .

qsv:lag1_autocorrelation a skos:Concept ;
    skos:prefLabel "lag1_autocorrelation"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:moarstatsCmd ;
    skos:exactMatch stats:Lag1Autocorrelation ;
    skos:definition "The lag-1 autocorrelation coefficient measuring serial correlation between consecutive non-null observations in file order: Σ(x_t − mean)(x_{t+1} − mean) / Σ(x_t − mean)²."@en .

qsv:benford_mad a skos:Concept ;
    skos:prefLabel "benford_mad"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:moarstatsCmd ;
    skos:exactMatch stats:BenfordMAD ;
    skos:definition "The mean absolute deviation between the observed first-significant-digit proportions and Benford’s law, used for data anomaly or fabrication detection."@en .

qsv:shannon_entropy a skos:Concept ;
    skos:prefLabel "shannon_entropy"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:moarstatsCmd ;
    skos:exactMatch stats:ShannonEntropy ;
    skos:definition "Shannon entropy measuring information content and uncertainty of the categorical or discrete value distribution: −Σ(p_i × log2(p_i))."@en .

qsv:normalized_entropy a skos:Concept ;
    skos:prefLabel "normalized_entropy"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:moarstatsCmd ;
    skos:exactMatch stats:NormalizedEntropy ;
    skos:definition "Normalized Shannon entropy scaled to the range [0, 1] (shannon_entropy / log2(cardinality)), where 0 indicates all identical values and 1 indicates uniform distribution."@en .

qsv:simpsons_diversity_index a skos:Concept ;
    skos:prefLabel "simpsons_diversity_index"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:moarstatsCmd ;
    skos:exactMatch stats:SimpsonsDiversityIndex ;
    skos:definition "Simpson’s diversity index (1 − Σ(p_i²)), measuring the probability that two randomly selected observations belong to different categories."@en .

qsv:xsd_type a skos:Concept ;
    skos:prefLabel "xsd_type"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:moarstatsCmd ;
    skos:broadMatch stats:InferredDataType ;
    skos:definition "The inferred W3C XML Schema Definition (XSD) datatype for the column (e.g., xsd:integer, xsd:gYear, xsd:dateTime)."@en .

qsv:covariance_population a skos:Concept ;
    skos:prefLabel "covariance_population"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:moarstatsCmd ;
    skos:closeMatch stats:Covariance ;
    skos:definition "The population covariance between two numeric or date fields."@en .

qsv:covariance_sample a skos:Concept ;
    skos:prefLabel "covariance_sample"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:moarstatsCmd ;
    skos:exactMatch stats:Covariance ;
    skos:definition "The sample covariance between two numeric or date fields."@en .

qsv:cramers_v a skos:Concept ;
    skos:prefLabel "cramers_v"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:moarstatsCmd ;
    skos:exactMatch stats:CramersV ;
    skos:definition "Cramér’s V measure of association between two categorical variables, ranging from 0 (independent) to 1 (perfect association)."@en .

qsv:kendall_tau a skos:Concept ;
    skos:prefLabel "kendall_tau"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:moarstatsCmd ;
    skos:exactMatch stats:KendallCorrelation ;
    skos:definition "Kendall’s rank correlation coefficient (tau) measuring monotonic relationship between two variables."@en .

qsv:mutual_information a skos:Concept ;
    skos:prefLabel "mutual_information"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:moarstatsCmd ;
    skos:exactMatch stats:MutualInformation ;
    skos:definition "Mutual information measuring the amount of information obtained about one variable through observing another."@en .

qsv:n_pairs a skos:Concept ;
    skos:prefLabel "n_pairs"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:moarstatsCmd ;
    skos:definition "The count of complete (pairwise non-null) observations used in computing bivariate statistics."@en .

qsv:normalized_mutual_information a skos:Concept ;
    skos:prefLabel "normalized_mutual_information"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:moarstatsCmd ;
    skos:exactMatch stats:NormalizedMutualInformation ;
    skos:definition "Normalized mutual information scaled to [0, 1] by dividing mutual information by the geometric mean of the marginal entropies."@en .

qsv:pearson_correlation a skos:Concept ;
    skos:prefLabel "pearson_correlation"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:moarstatsCmd ;
    skos:exactMatch stats:PearsonCorrelation ;
    skos:definition "Pearson product-moment correlation coefficient measuring linear relationship between two variables."@en .

qsv:r_squared a skos:Concept ;
    skos:prefLabel "r_squared"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:moarstatsCmd ;
    skos:exactMatch stats:CoefficientOfDetermination ;
    skos:definition "The coefficient of determination (R²) representing the proportion of variance in field2 explained by simple linear regression on field1."@en .

qsv:regression_intercept a skos:Concept ;
    skos:prefLabel "regression_intercept"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:moarstatsCmd ;
    skos:exactMatch stats:RegressionIntercept ;
    skos:definition "The y-intercept parameter of an ordinary least-squares simple linear regression line."@en .

qsv:regression_slope a skos:Concept ;
    skos:prefLabel "regression_slope"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:moarstatsCmd ;
    skos:exactMatch stats:RegressionSlope ;
    skos:definition "The slope parameter of an ordinary least-squares simple linear regression line."@en .

qsv:spearman_correlation a skos:Concept ;
    skos:prefLabel "spearman_correlation"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:moarstatsCmd ;
    skos:exactMatch stats:SpearmanCorrelation ;
    skos:definition "Spearman’s rank correlation coefficient measuring monotonic relationship between two variables."@en .

qsv:u_field1_given_field2 a skos:Concept ;
    skos:prefLabel "u_field1_given_field2"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:moarstatsCmd ;
    skos:broadMatch stats:UncertaintyCoefficient ;
    skos:definition "Theil’s uncertainty coefficient (Theil’s U) measuring the proportion of information in field1 predictable given field2."@en .

qsv:u_field2_given_field1 a skos:Concept ;
    skos:prefLabel "u_field2_given_field1"@en ;
    skos:inScheme qsv: ;
    skos:broader qsv:moarstatsCmd ;
    skos:broadMatch stats:UncertaintyCoefficient ;
    skos:definition "Theil’s uncertainty coefficient (Theil’s U) measuring the proportion of information in field2 predictable given field1."@en .

