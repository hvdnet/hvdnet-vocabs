@prefix stats: <https://w3id.org/hvdnet/statistics/> .
@prefix statscv: <https://w3id.org/hvdnet/statistics/cv/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix wikidata: <https://wikidata.org/wiki/> .
@prefix ddi: <http://rdf-vocabulary.ddialliance.org/cv/SummaryStatisticType/2.1.2/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Crosswalks: Concepts may include skos:exactMatch links to Wikidata
# using the wikidata: prefix above (https://wikidata.org/wiki/).
# Use skos:closeMatch where equivalence is weaker. Future revisions may
# adopt Wikidata entity IRIs (e.g., http://www.wikidata.org/entity/Q19033)
# for improved machine-resolution.


# Property declarations (custom annotations)

statscv:formula a rdf:Property ;
    rdfs:label "formula"@en ;
    rdfs:comment "Compact mathematical formula (e.g., LaTeX) describing how the statistic is computed."@en ;
    rdfs:domain skos:Concept ;
    rdfs:range xsd:string .

statscv:computationMethod a rdf:Property ;
   rdfs:label "computation method"@en ;
    rdfs:comment "Brief textual steps describing how to compute the statistic, including conventions and exclusions."@en ;
    rdfs:domain skos:Concept ;
    rdfs:range xsd:string .

stats: a skos:ConceptScheme ;
    dct:title "Descriptive Statistics Vocabulary [DRAFT]"@en ;
    dct:description "The descriptive statistics vocabulary provides a controlled set of concepts for describing statistical measures and summary statistics for FAIR data."@en ;
    dct:created "2025-12-20"^^xsd:date ;
    dct:modified "2026-11-15"^^xsd:date ;
    skos:hasTopConcept stats:AssociationDependence, stats:CategoricalProfiling, stats:CentralTendency, 
        stats:DerivedRatios, stats:Dispersion, stats:FileLevel, stats:InformationContent, 
        stats:Metadata, stats:MissingnessCompleteness, stats:Outliers, stats:RobustStatistics, 
        stats:ShapeDistribution, stats:SizeCount, stats:TextMeasures ;
    dct:license <https://creativecommons.org/publicdomain/zero/1.0/> .

# Categories

stats:AssociationDependence a skos:Concept ;
    skos:prefLabel "Association/Dependence"@en ;
    skos:topConceptOf stats: ;
    skos:narrower         stats:CoefficientOfDetermination, stats:Covariance, stats:CramersV, stats:KendallCorrelation,
        stats:Lag1Autocorrelation, stats:MaxAbsCorrelation, stats:MutualInformation,
        stats:NormalizedMutualInformation, stats:PearsonCorrelation, stats:RegressionIntercept,
        stats:RegressionSlope, stats:SpearmanCorrelation, stats:UncertaintyCoefficient .

stats:CategoricalProfiling a skos:Concept ;
    skos:prefLabel "Categorical Profiling"@en ;
    skos:topConceptOf stats: ;
    skos:narrower         stats:BergerParkerIndex, stats:CardinalityBucket, stats:ImbalanceRatio, stats:SimpsonsDiversityIndex,
        stats:TopKCategories, stats:TopKCategoryShare .

stats:CentralTendency a skos:Concept ;
    skos:prefLabel "Central Tendency/Location"@en ;
    skos:topConceptOf stats: ;
    skos:narrower 
                stats:ArithmeticMean, stats:EighthDecile, stats:FifthDecile, stats:FirstDecile, stats:FirstQuartile,
        stats:FirstQuintile, stats:FourthDecile, stats:FourthQuintile, stats:GeometricMean,
        stats:HarmonicMean, stats:Maximum, stats:Median, stats:Midhinge, stats:Minimum, stats:Mode,
        stats:NinthDecile, stats:OtherPercentile, stats:SecondDecile, stats:SecondQuartile,
        stats:SecondQuintile, stats:SeventhDecile, stats:SixthDecile, stats:Sum, stats:ThirdDecile,
        stats:ThirdQuartile, stats:ThirdQuintile, stats:TrimmedMean, stats:WinsorizedMean .

stats:DerivedRatios a skos:Concept ;
    skos:prefLabel "Derived/Other Ratios"@en ;
    skos:topConceptOf stats: ;  
    skos:narrower         stats:CoefficientOfVariation, stats:DistinctnessRatio, stats:LengthCoefficientOfVariation,
        stats:ModeFrequencyRatio, stats:ModeZScore, stats:NegativeShare, stats:NonZeroRate,
        stats:OutlierPercentage, stats:PercentageOfInvalidCases, stats:PercentageOfValidCases,
        stats:PercentileRatio, stats:PositiveShare, stats:QuartileDispersionCoefficient,
        stats:RelativeStandardError, stats:RobustCoefficientOfVariation, stats:StdDevRangeRatio,
        stats:ZeroShare .

stats:Dispersion a skos:Concept ;
    skos:prefLabel "Dispersion/Variability"@en ;
    skos:topConceptOf stats: ;
    skos:narrower         stats:AtkinsonIndex, stats:AverageAbsoluteDeviation, stats:GiniCoefficient, stats:HooverIndex,
        stats:InterdecileRange, stats:InterquartileRange, stats:InterquintileRange, stats:LCV,
        stats:MedianAbsoluteDeviation, stats:NormalizedIQR, stats:NormalizedMAD, stats:PercentileRatio,
        stats:QnEstimator, stats:Range, stats:RelativeStandardError, stats:SnEstimator,
        stats:StandardDeviation, stats:StandardErrorOfMean, stats:TheilIndex, stats:Variance .

stats:FileLevel a skos:Concept ;
    skos:prefLabel "File-level Statistics/Attributes"@en ;
    skos:topConceptOf stats: ;
    skos:narrower stats:FileChecksum, stats:FileCompression, stats:FileCreationTime, stats:FileEncoding, 
        stats:FileLastModifiedTime, stats:FileMimeType, stats:FileRecordCount, stats:FileSchemaVersion, 
        stats:FileSizeBytes, stats:FileVariableCount, stats:RecordVariableRatio .

stats:InformationContent a skos:Concept ;
    skos:prefLabel "Information Content"@en ;
    skos:topConceptOf stats: ;
    skos:narrower         stats:BergerParkerIndex, stats:MutualInformation, stats:NormalizedEntropy,
        stats:NormalizedMutualInformation, stats:Perplexity, stats:ShannonEntropy,
        stats:SimpsonsDiversityIndex, stats:UncertaintyCoefficient .

stats:Metadata a skos:Concept ;
    skos:prefLabel "Metadata"@en ;
    skos:topConceptOf stats: ;
    skos:narrower         stats:DecimalPrecision, stats:InferredDataType, stats:IsAscii, stats:SortOrder,
        stats:ZeroPaddedNumeric .

stats:MissingnessCompleteness a skos:Concept ;
    skos:prefLabel "Missingness/Completeness"@en ;
    skos:topConceptOf stats: ;
    skos:narrower stats:DistinctnessRatio, stats:DuplicateRows, stats:InvalidCases, stats:MissingRate, stats:NonNullRate, stats:NullCases .

stats:Outliers a skos:Concept ;
    skos:prefLabel "Outliers"@en ;
    skos:topConceptOf stats: ;
    skos:narrower         stats:LowerInnerFence, stats:LowerOuterFence, stats:OutlierCountIQR, stats:OutlierCountZScore,
        stats:OutlierPercentage, stats:UpperInnerFence, stats:UpperOuterFence .

stats:RobustStatistics a skos:Concept ;
    skos:prefLabel "Robust Location/Scale"@en ;
    skos:topConceptOf stats: ;
    skos:narrower         stats:BiweightMidvariance, stats:LCV, stats:LKurtosis, stats:LSkewness, stats:Midhinge,
        stats:Midrange, stats:NormalizedIQR, stats:NormalizedMAD, stats:QnEstimator,
        stats:RobustCoefficientOfVariation, stats:SnEstimator, stats:Trimean, stats:TrimmedMean,
        stats:WinsorizedMean .

stats:ShapeDistribution a skos:Concept ;
    skos:prefLabel "Shape/Distribution"@en ;
    skos:topConceptOf stats: ;
    skos:narrower         stats:AndersonDarling, stats:BenfordMAD, stats:Beta1, stats:Beta2, stats:BimodalityCoefficient,
        stats:BowleySkewnessCoefficient, stats:ExcessKurtosis, stats:FisherSkewness, stats:JarqueBera,
        stats:KellySkewness, stats:KolmogorovSmirnov, stats:LKurtosis, stats:LSkewness,
        stats:Lag1Autocorrelation, stats:PearsonSkewness, stats:PopulationExcessKurtosis,
        stats:PopulationSkewness, stats:SampleExcessKurtosis, stats:SampleSkewness, stats:ShapiroWilk .

stats:SizeCount a skos:Concept ;
    skos:prefLabel "Size/Count"@en ;
    skos:topConceptOf stats: ;
    skos:narrower         stats:DecimalPrecision, stats:Frequency, stats:InvalidCases, stats:NegativeCount, stats:NullCases,
        stats:Other, stats:PositiveCount, stats:SignificantDigits, stats:Sparsity, stats:UniqueCases,
        stats:ValidCases, stats:ZeroCount .

stats:TextMeasures a skos:Concept ;
    skos:prefLabel "Text/String Measures"@en ;
    skos:topConceptOf stats: ;
    skos:narrower         stats:AverageLength, stats:AverageWordCount, stats:Languages, stats:LengthCoefficientOfVariation,
        stats:LengthStdDev, stats:LengthVariance, stats:LexicalDiversity, stats:MaxLength,
        stats:MaxWordCount, stats:MinLength, stats:MinWordCount, stats:TotalCharacterLength,
        stats:TotalWordCount, stats:UniqueWordCount .

# Concepts - Central Tendency/Location

stats:ArithmeticMean a skos:Concept ;
    skos:prefLabel "Arithmetic mean"@en ;
    skos:definition "The sum of all values divided by the number of values."@en ;
    skos:scopeNote "Compute by summing valid values and dividing by the count; exclude missing or invalid entries."@en ;
    statscv:formula "$\\bar{x} = \\frac{1}{n} \\sum_{i=1}^{n} x_i$" ;
    statscv:computationMethod "Sum all non-missing values and divide by the number of non-missing observations (n)."@en ;
    skos:broader stats:CentralTendency ;
    skos:inScheme stats: ;
    skos:exactMatch wikidata:Q19033, ddi:7975ed0 .

stats:GeometricMean a skos:Concept ;
    skos:prefLabel "Geometric mean"@en ;
    skos:definition "The nth root of the product of n values."@en ;
    skos:scopeNote "Use only for positive values; multiply valid values and take the nth root."@en ;
    statscv:formula "$\\left(\\prod_{i=1}^{n} x_i\\right)^{1/n}$" ;
    statscv:computationMethod "Multiply all positive, non-missing values and raise to the power of 1/n."@en ;
    skos:broader stats:CentralTendency ;
    skos:inScheme stats: ;
    skos:exactMatch wikidata:Q185049, ddi:cd8ebb0 .

stats:HarmonicMean a skos:Concept ;
    skos:prefLabel "Harmonic mean"@en ;
    skos:definition "The reciprocal of the arithmetic mean of reciprocals."@en ;
    skos:scopeNote "Useful for rates; invert non-zero values, average, then invert back."@en ;
    statscv:formula "$\\left( \\frac{1}{n} \\sum_{i=1}^{n} \\frac{1}{x_i} \\right)^{-1}$" ;
    statscv:computationMethod "Compute the mean of reciprocals of valid, non-zero values and invert the result."@en ;
    skos:broader stats:CentralTendency ;
    skos:inScheme stats: ;
    skos:exactMatch wikidata:Q188347, ddi:71996c9 .

stats:TrimmedMean a skos:Concept ;
    skos:prefLabel "Trimmed mean"@en ;
    skos:definition "The mean calculated after removing a specified percentage of extreme values from both ends."@en ;
    skos:scopeNote "Sort values, drop a fixed proportion from both tails, then average the remainder."@en ;
    statscv:formula "Informal: average of the middle (1−2α) fraction after α-trim on both tails" ;
    statscv:computationMethod "Sort valid values, remove α·n lowest and α·n highest observations, compute the arithmetic mean of the rest."@en ;
    skos:broader stats:CentralTendency, stats:RobustStatistics ;
    skos:inScheme stats: ;
    skos:exactMatch wikidata:Q32278, ddi:17ff276 .

stats:WinsorizedMean a skos:Concept ;
    skos:prefLabel "Winsorized Mean"@en ;
    skos:definition "The mean calculated after replacing extreme values with less extreme values at specified percentiles."@en ;
    skos:scopeNote "Replace α-tail extremes with boundary values at chosen percentiles, then average."@en ;
    statscv:formula "Informal: mean after Winsorizing tails at chosen cutoffs (e.g., 5th/95th percentiles)" ;
    statscv:computationMethod "Winsorize: clamp values below the lower cutoff to the cutoff, and above the upper cutoff to the cutoff; compute arithmetic mean."@en ;
    skos:broader stats:CentralTendency, stats:RobustStatistics ;
    skos:inScheme stats: ;
    skos:exactMatch wikidata:Q2989389 .

stats:Mode a skos:Concept ;
    skos:prefLabel "Mode"@en ;
    skos:definition "The most frequently occurring value in a dataset."@en ;
    skos:scopeNote "Count the frequency of each distinct value; select the value(s) with maximum count."@en ;
    statscv:computationMethod "Compute a frequency table over valid values and return the category with highest frequency (ties possible)."@en ;
    skos:broader stats:CentralTendency ;
    skos:inScheme stats: ;
    skos:exactMatch wikidata:Q188224, ddi:650be61 .

stats:Median a skos:Concept ;
    skos:prefLabel "Median"@en ;
    skos:definition "The middle value when data are sorted in order."@en ;
    skos:scopeNote "Sort values; pick the middle for odd n, or average the two middles for even n (depending on convention)."@en ;
    statscv:formula "For odd n: $x_{( (n+1)/2 )}$; for even n: $\\frac{x_{(n/2)} + x_{(n/2+1)}}{2}$" ;
    statscv:computationMethod "Sort non-missing values; select median according to chosen convention (inclusive/exclusive)."@en ;
    skos:broader stats:CentralTendency ;
    skos:inScheme stats: ;
    skos:exactMatch wikidata:Q226995, ddi:66851a3 .

stats:Minimum a skos:Concept ;
    skos:prefLabel "Minimum"@en ;
    skos:definition "The smallest value in a dataset."@en ;
    skos:scopeNote "Scan all valid values and return the smallest observed value."@en ;
    statscv:computationMethod "Compute the min over non-missing values."@en ;
    skos:broader stats:CentralTendency ;
    skos:inScheme stats: ;
    skos:exactMatch wikidata:Q10585806, ddi:a1d0ec6 .

stats:Maximum a skos:Concept ;
    skos:prefLabel "Maximum"@en ;
    skos:definition "The largest value in a dataset."@en ;
    skos:scopeNote "Scan all valid values and return the largest observed value."@en ;
    statscv:computationMethod "Compute the max over non-missing values."@en ;
    skos:broader stats:CentralTendency ;
    skos:inScheme stats: ;
    skos:exactMatch wikidata:Q10578722, ddi:8321e79 .

stats:Sum a skos:Concept ;
    skos:prefLabel "Sum"@en ;
    skos:definition "The total obtained by adding all values together."@en ;
    skos:scopeNote "Add up all valid values; exclude missing or invalid entries."@en ;
    statscv:formula "$\\sum_{i=1}^{n} x_i$" ;
    statscv:computationMethod "Accumulate over non-missing values."@en ;
    skos:broader stats:CentralTendency ;
    skos:inScheme stats: ;
    skos:exactMatch wikidata:Q218005, ddi:a0ec870 .

stats:FirstQuartile a skos:Concept ;
    skos:prefLabel "First quartile"@en ;
    skos:definition "The 25th percentile, below which 25% of data values fall."@en ;
    skos:broader stats:CentralTendency ;
    skos:inScheme stats: ;
    skos:exactMatch wikidata:Q112468319, ddi:350c70a .

stats:SecondQuartile a skos:Concept ;
    skos:prefLabel "Second quartile"@en ;
    skos:definition "The 50th percentile (median), below which 50% of data values fall."@en ;
    skos:broader stats:CentralTendency ;
    skos:inScheme stats: ;
    skos:exactMatch wikidata:Q226995, ddi:f02fd7a .

stats:ThirdQuartile a skos:Concept ;
    skos:prefLabel "Third quartile"@en ;
    skos:definition "The 75th percentile, below which 75% of data values fall."@en ;
    skos:broader stats:CentralTendency ;
    skos:inScheme stats: ;
    skos:exactMatch wikidata:Q112468502, ddi:ebe9990 .

stats:FirstQuintile a skos:Concept ;
    skos:prefLabel "First quintile"@en ;
    skos:definition "The 20th percentile, below which 20% of data values fall."@en ;
    skos:broader stats:CentralTendency ;
    skos:inScheme stats: ;
