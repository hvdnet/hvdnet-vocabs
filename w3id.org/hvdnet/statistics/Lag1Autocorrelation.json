{
  "id": "https://w3id.org/hvdnet/statistics/Lag1Autocorrelation",
  "type": "Concept",
  "prefLabel": {
    "en": "Lag-1 autocorrelation"
  },
  "definition": {
    "en": "The Pearson correlation between consecutive observations in sequence order, measuring serial dependence or trend."
  },
  "scopeNote": {
    "en": [
      "Values near +1 indicate strong positive serial correlation or ordering; values near 0 indicate serial independence."
    ]
  },
  "inScheme": [
    {
      "id": "https://w3id.org/hvdnet/statistics/",
      "title": {
        "en": "Descriptive Statistics Vocabulary [DRAFT]"
      }
    }
  ],
  "inSchemeAll": [
    {
      "id": "https://w3id.org/hvdnet/statistics/"
    }
  ],
  "formula": "$r_1 = \\frac{\\sum_{t=1}^{n-1} (x_t - \\bar{x})(x_{t+1} - \\bar{x})}{\\sum_{t=1}^{n} (x_t - \\bar{x})^2}$",
  "computationMethod": {
    "en": "Compute mean over ordered valid observations, sum products of consecutive centered values, and divide by total sum of squares."
  },
