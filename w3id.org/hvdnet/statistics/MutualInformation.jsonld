{
  "id": "https://w3id.org/hvdnet/statistics/MutualInformation",
  "type": "Concept",
  "prefLabel": {
    "en": "Mutual information"
  },
  "definition": {
    "en": "A measure of the mutual dependence between two variables, quantifying the amount of information obtained about one variable by observing the other."
  },
  "scopeNote": {
    "en": [
      "Compute from joint and marginal probability distributions; equals 0 if and only if the variables are statistically independent."
    ]
  },
  "inScheme": [
    {
      "id": "https://w3id.org/hvdnet/statistics/",
      "title": {
        "en": "Descriptive Statistics Vocabulary [DRAFT]"
      }
    }
  ],
  "inSchemeAll": [
    {
      "id": "https://w3id.org/hvdnet/statistics/"
    }
  ],
  "formula": "$I(X; Y) = \\sum_{y \\in Y} \\sum_{x \\in X} p(x, y) \\log \\left( \\frac{p(x, y)}{p(x) p(y)} \\right)$",
  "computationMethod": {
    "en": "Estimate joint and marginal frequencies over paired valid observations and sum p(x,y) * log(p(x,y) / (p(x)*p(y)))."
  },
