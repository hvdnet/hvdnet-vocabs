{
  "id": "https://w3id.org/hvdnet/statistics/NormalizedMutualInformation",
  "type": "Concept",
  "prefLabel": {
    "en": "Normalized mutual information"
  },
  "definition": {
    "en": "Mutual information scaled to the interval [0, 1] by dividing by a function of the marginal entropies (e.g., geometric or arithmetic mean)."
  },
  "scopeNote": {
    "en": [
      "Commonly normalized by the geometric mean sqrt(H(X) * H(Y)) or arithmetic mean (H(X) + H(Y)) / 2 of the individual entropies."
    ]
  },
  "inScheme": [
    {
      "id": "https://w3id.org/hvdnet/statistics/",
      "title": {
        "en": "Descriptive Statistics Vocabulary [DRAFT]"
      }
    }
  ],
  "inSchemeAll": [
    {
      "id": "https://w3id.org/hvdnet/statistics/"
    }
  ],
  "formula": "$\\mathrm{NMI}(X, Y) = \\frac{I(X; Y)}{\\sqrt{H(X) H(Y)}}$",
  "computationMethod": {
    "en": "Compute mutual information I(X;Y) and individual Shannon entropies H(X), H(Y), then divide I(X;Y) by the chosen normalization factor."
  },
