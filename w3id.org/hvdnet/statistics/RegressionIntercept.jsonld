{
  "id": "https://w3id.org/hvdnet/statistics/RegressionIntercept",
  "type": "Concept",
  "prefLabel": {
    "en": "Simple linear regression intercept"
  },
  "definition": {
    "en": "The expected value of the dependent variable when the independent variable equals zero in an ordinary least-squares linear fit."
  },
  "scopeNote": {
    "en": [
      "Computed from the means of x and y and the estimated regression slope."
    ]
  },
  "broader": {
    "id": "https://w3id.org/hvdnet/statistics/AssociationDependence",
    "prefLabel": {
      "en": "Association/Dependence"
    }
  },
  "inScheme": [
    {
      "id": "https://w3id.org/hvdnet/statistics/",
      "title": {
        "en": "Descriptive Statistics Vocabulary [DRAFT]"
      }
    }
  ],
  "inSchemeAll": [
    {
      "id": "https://w3id.org/hvdnet/statistics/"
    }
  ],
  "formula": "$\\beta_0 = \\bar{y} - \\beta_1 \\bar{x}$",
  "computationMethod": {
    "en": "Compute means of x and y and the regression slope beta_1, then compute y_bar - beta_1 * x_bar."
  },
