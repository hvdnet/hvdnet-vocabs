{
  "id": "https://w3id.org/hvdnet/statistics/RelativeStandardError",
  "type": "Concept",
  "prefLabel": {
    "en": "Relative standard error"
  },
  "definition": {
    "en": "The standard error of the mean expressed as a ratio or percentage of the arithmetic mean."
  },
  "scopeNote": {
    "en": [
      "Measures the relative precision of the sample mean estimate; undefined when mean is zero."
    ]
  },
  "inScheme": [
    {
      "id": "https://w3id.org/hvdnet/statistics/",
      "title": {
        "en": "Descriptive Statistics Vocabulary [DRAFT]"
      }
    }
  ],
  "inSchemeAll": [
    {
      "id": "https://w3id.org/hvdnet/statistics/"
    }
  ],
  "formula": "$\\mathrm{RSE} = \\frac{\\mathrm{SEM}}{\\bar{x}}$",
  "computationMethod": {
    "en": "Compute the standard error of the mean and divide by the arithmetic mean."
  },
