{
  "id": "https://w3id.org/hvdnet/statistics/UncertaintyCoefficient",
  "type": "Concept",
  "prefLabel": {
    "en": "Uncertainty coefficient"
  },
  "altLabel": {
    "en": [
      "Theil's U"
    ]
  },
  "definition": {
    "en": "A directed measure of nominal association representing the proportion of uncertainty (entropy) in one variable reduced by knowing the other."
  },
  "scopeNote": {
    "en": [
      "Asymmetric measure in [0, 1]; U(Y|X) = I(X;Y) / H(Y)."
    ]
  },
  "inScheme": [
    {
      "id": "https://w3id.org/hvdnet/statistics/",
      "title": {
        "en": "Descriptive Statistics Vocabulary [DRAFT]"
      }
    }
  ],
  "inSchemeAll": [
    {
      "id": "https://w3id.org/hvdnet/statistics/"
    }
  ],
  "formula": "$U(Y \\mid X) = \\frac{I(X; Y)}{H(Y)}$",
  "computationMethod": {
    "en": "Compute mutual information I(X;Y) and divide by the Shannon entropy of the target variable H(Y)."
  },
