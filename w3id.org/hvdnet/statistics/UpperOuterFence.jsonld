{
  "id": "https://w3id.org/hvdnet/statistics/UpperOuterFence",
  "type": "Concept",
  "prefLabel": {
    "en": "Upper outer Tukey fence"
  },
  "definition": {
    "en": "The upper threshold for extreme outliers under Tukey's IQR rule, typically Q3 + 3 × IQR."
  },
  "scopeNote": {
    "en": [
      "Observations above this threshold are classified as extreme upper outliers."
    ]
  },
  "broader": {
    "id": "https://w3id.org/hvdnet/statistics/Outliers",
    "prefLabel": {
      "en": "Outliers"
    }
  },
  "inScheme": [
    {
      "id": "https://w3id.org/hvdnet/statistics/",
      "title": {
        "en": "Descriptive Statistics Vocabulary [DRAFT]"
      }
    }
  ],
  "inSchemeAll": [
    {
      "id": "https://w3id.org/hvdnet/statistics/"
    }
  ],
  "formula": "$Q_3 + 3 \\times \\mathrm{IQR}$",
  "computationMethod": {
    "en": "Compute third quartile Q3 and interquartile range IQR, then add 3 * IQR to Q3."
  },
